<!--                    <include>**/Kwitansi-Faktur.jrxml</include>-->
<!--                    <include>**/Ringkasan-Faktur.jrxml</include>-->
<!--                </includes>-->
<!--            </resource>-->
<!--        </resources>-->
    </build>

</project>
